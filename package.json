{
  "name": "personal_website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run index:search",
    "build:next": "next build",
    "index:search": "npx tsx scripts/inject-pagefind-sidecar.ts && pagefind --site .next/server/app --output-path public/pagefind",
    "start": "next start",
    "lint": "eslint",
    "design": "echo 'Serving from repo root — open: http://localhost:8765/.claude/visual-diffs/soul-atlas/gallery.html' && python3 -m http.server 8765",
    "harness:check": "bash .claude/hooks/harness-check.sh",
    "harness:audit": "bash scripts/audit-design-tokens.sh && bash scripts/audit-territory.sh && bash scripts/audit-soul-atom-drift.sh && bash scripts/audit-font-chain.sh",
    "harness:barrier-class": "bash scripts/audit-rail-barrier-class.sh",
    "harness:permissions": "bash scripts/audit-permissions-nonempty.sh",
    "harness:least-agency": "bash scripts/audit-least-agency-config.sh",
    "backup:content": "npx tsx scripts/export-mdx.ts && git add -f content && git commit -m \"backup(content): MDX export $(date +%Y-%m-%dT%H:%M:%S) [backup/content]\" -- content"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.195",
    "@mdx-js/mdx": "^3.1.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "ai": "^6.0.193",
    "animejs": "^4.4.1",
    "heic-convert": "^2.1.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "simplex-noise": "^4.0.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@tailwindcss/postcss": "^4",
    "@types/animejs": "^3.1.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "axe-core": "^4.11.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "exifr": "^7.1.3",
    "pagefind": "^1.5.2",
    "playwright": "1.61.0-alpha-1778188671000",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# harness runtime artifacts (logs) — keep dir, ignore content
.claude/hook-logs/*.log
.claude/worktrees/

# harness runtime artifacts (baselines / runtime state) — keep dirs, ignore content
.claude/hook-logs/*.json
# visual-diff scratch sources — external-bundle extractions, regenerable via scripts/fetch-design-bundle.sh
.claude/visual-diffs/*/source/

# next.js dev server logs (runtime artifacts in visual-diff capture dirs)
.claude/visual-diffs/*/dev.log
.claude/visual-diffs/*/.devpid

# checkpoint archive (timestamped immutable history) — keep rolling head SAVE-POINT.md, ignore archive
# .gitkeep is tracked so the directory exists in fresh clones
docs/team/.checkpoints/*.md

# checkpoint session state (temp marker + agent counter temp dirs)
.claude/.last-checkpoint

# beta private memory — grants are runtime artifacts (gitignored); ACCESS-LOG.md is kept
.claude/beta/grants/*.json

# session metadata — runtime artifacts written per-session
.claude/sessions/*.meta.json

# ─── lean working tree (2026-05-29) ───
# stray/legacy scaffold + skills tooling artifacts (not project source)
/worldline-harness/
# harness engine — dormant ported substrate kept on disk, NOT tracked (farm-erp heritage:
# attestations/judges/LSP/RLS sensors Worldline doesn't use). Only the live denylist data the
# wired hook reads + the resolution doc are force-added (git add -f) and stay tracked.
/.harness/engine/
/.agents/
/skills-lock.json
.claude/.current-persona

# scratch screenshots dropped in repo root (regenerable proof captures)
/*.png

# pre-handoff status drafts (Polaris merges these into STATUS.md)
docs/team/.status-drafts/

# inter-agent process metadata — audit trail lives in git history, not the tree
.claude/handoffs/
.claude/signatures/*.json

# visual-diff proof screenshots (anywhere under visual-diffs) — regenerable; gallery/prototype SOURCE (html/css/fonts/js) stays tracked
.claude/visual-diffs/**/*.png

# build + tooling caches (not project source)
/.velite/
# codegraph MCP — per-machine local state (SQLite index + daemon.pid + a Unix
# socket). LOAD-BEARING: also keeps Tailwind v4's source-scan out of this dir so
# it can't try to read daemon.sock as a file and panic Turbopack (os error 102,
# ENOTSUP) on the photo routes. Do NOT remove without re-fixing that.
/.codegraph/
# pagefind search index (regenerates on every build — never committed)
/public/pagefind/

# ─── photo media — binary, NOT git (foundation D7, 2026-06-09) ───
# At scale (10k photos / RAW / HEIC) binaries belong in object storage + CDN, never
# git (the binary-in-git bomb Peat flagged). Generated variants + source binaries +
# the regenerable .cache/ are all ignored; ONLY the .mdx sidecars (text metadata =
# the entry source) stay tracked. See ~/.claude/plans/recursive-sparking-stardust.md.
/public/photos/
content/photos/**
!content/photos/**/
!content/photos/**/*.mdx
/.playwright-mcp/
/.codex/
.claude/skills/
.claude/skill-staging/
.claude/exports/
.claude/parses/
.claude/sessions/

# session transcripts dropped in the tree
*-this-session-is-being-continued-from-a-previous-c.txt

# pilot prototype — kept on disk as a backup reference, out of git
/pilot-frontend-ui-design/

# ─── inter-agent process scratch (2026-06-02) — audit trail lives in git history, not the tree ───
.claude/hook-logs/
.claude/beta/
.claude/workflows/
# per-task visual-diff records (REVIEW.md / manifest.json / snapshots) — regenerable; the soul-atlas gallery stays tracked
.claude/visual-diffs/*
!.claude/visual-diffs/soul-atlas
